{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/causal-kernel/kernel_ast.schema.json",
  "title": "Causal Kernel Program AST v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "domain",
    "statements"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "extensions": {
      "type": "object"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "description": "Slice #36. Opt-in per-run toggles that shape how the kernel treats partially-specified programs. Absent is default (backward-compatible with all pre-#36 fixtures).",
      "properties": {
        "strict_framing": {
          "type": "boolean",
          "description": "When true, effect / probability queries whose referenced predicates still have A0 framing gaps flip to needs_investigation before numeric evaluation. The F1 DEFINE_VARIABLE channel still fires with the same skeletons so the fill-back loop is unchanged — only the numeric path is gated."
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectDecl"
          }
        }
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Composite confidence score for the whole input item; not a statistical interval."
        },
        "source": {
          "type": "string"
        }
      }
    },
    "objectDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "const": "object"
        },
        "name": {
          "$ref": "atom.schema.json#/$defs/identifier"
        }
      }
    },
    "causeStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "kind": {
          "const": "cause"
        },
        "forall": {
          "type": "array",
          "items": {
            "$ref": "atom.schema.json#/$defs/variableName"
          }
        },
        "from": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "to": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "annotations": {
          "$ref": "#/$defs/annotation",
          "description": "Slice A2: provenance / confidence metadata for this edge, e.g. {\"source\": \"llm_proposal\"} for a hypothesis edge, {\"source\": \"PubMed:...\"} for an evidence-backed edge. Reasoning rules do not read this."
        }
      }
    },
    "bidirectedStatement": {
      "type": "object",
      "description": "Phase 2.latent S1. An undirected 'bidirected' edge between two observed atoms, semantically declaring the existence of at least one unobserved common cause (semi-Markov representation). The kind is accepted by the schema but cannot yet be dispatched by the runtime — programs containing bidirectedStatement raise SemanticError until Phase 2.latent S2+ lands m-separation + c-component support. See PHASE_2_LATENT_CHARTER.md.",
      "additionalProperties": false,
      "required": [
        "kind",
        "left",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "bidirected"
        },
        "forall": {
          "type": "array",
          "items": {
            "$ref": "atom.schema.json#/$defs/variableName"
          }
        },
        "left": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "right": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "annotations": {
          "$ref": "#/$defs/annotation",
          "description": "Provenance / confidence metadata for the bidirected edge. Not consumed by reasoning rules in S1."
        }
      }
    },
    "probabilityStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "given",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "probability"
        },
        "forall": {
          "type": "array",
          "items": {
            "$ref": "atom.schema.json#/$defs/variableName"
          }
        },
        "target": {
          "$ref": "atom.schema.json#/$defs/groundedAtom",
          "description": "Target atom with the specific value this conditional refers to, e.g. {atom: cancer(X), value: true}."
        },
        "given": {
          "type": "array",
          "description": "Model conditioning set for the target, each entry a groundedAtom at a specific value. In v0.1 this should align with the target's structural parent set, or a subset of it.",
          "items": {
            "$ref": "atom.schema.json#/$defs/groundedAtom"
          }
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Model-world conditional probability value, not an empirical sample frequency."
        },
        "annotations": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "observationStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "atom",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "observation"
        },
        "atom": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        },
        "annotations": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom",
        "value"
      ],
      "properties": {
        "atom": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        }
      }
    },
    "causeQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "kind": {
          "const": "cause"
        },
        "from": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "to": {
          "$ref": "atom.schema.json#/$defs/atom"
        }
      }
    },
    "assocQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left",
        "right",
        "given"
      ],
      "properties": {
        "kind": {
          "const": "assoc"
        },
        "left": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "right": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "given": {
          "type": "array",
          "description": "Condition set for the structural association query.",
          "items": {
            "$ref": "atom.schema.json#/$defs/atom"
          }
        }
      }
    },
    "effectQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "intervention",
        "given"
      ],
      "properties": {
        "kind": {
          "const": "effect"
        },
        "target": {
          "$ref": "atom.schema.json#/$defs/groundedAtom",
          "description": "Target atom with the specific value whose probability under intervention is being queried, e.g. {atom: cancer(alice), value: true}."
        },
        "intervention": {
          "$ref": "#/$defs/intervention"
        },
        "given": {
          "type": "array",
          "description": "Observed condition set applied together with the intervention, each at a specific value.",
          "items": {
            "$ref": "atom.schema.json#/$defs/groundedAtom"
          }
        }
      }
    },
    "identifyQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "intervention",
        "given"
      ],
      "properties": {
        "kind": {
          "const": "identify"
        },
        "target": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "intervention": {
          "$ref": "#/$defs/intervention"
        },
        "given": {
          "type": "array",
          "description": "Observed condition set for the interventional quantity to be identified.",
          "items": {
            "$ref": "atom.schema.json#/$defs/atom"
          }
        }
      }
    },
    "probabilityQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "given"
      ],
      "properties": {
        "kind": {
          "const": "probability"
        },
        "target": {
          "$ref": "atom.schema.json#/$defs/groundedAtom",
          "description": "Target atom with the specific value whose conditional probability is being queried."
        },
        "given": {
          "type": "array",
          "items": {
            "$ref": "atom.schema.json#/$defs/groundedAtom"
          }
        }
      }
    },
    "counterfactualQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "observed",
        "counterfactual_intervention",
        "counterfactual_target"
      ],
      "properties": {
        "kind": {
          "const": "counterfactual"
        },
        "observed": {
          "$ref": "atom.schema.json#/$defs/groundedAtom",
          "description": "Observed factual world assignment, e.g. chose_major=false."
        },
        "counterfactual_intervention": {
          "$ref": "#/$defs/intervention"
        },
        "counterfactual_target": {
          "$ref": "atom.schema.json#/$defs/groundedAtom",
          "description": "Counterfactual target event whose probability is being queried."
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "monotonicity"
          ],
          "properties": {
            "monotonicity": {
              "type": "string",
              "enum": [
                "non_decreasing",
                "non_increasing"
              ]
            }
          }
        },
        "factual_target_known": {
          "type": [
            "boolean",
            "number",
            "string",
            "null"
          ]
        }
      }
    },
    "query": {
      "oneOf": [
        {
          "$ref": "#/$defs/causeQuery"
        },
        {
          "$ref": "#/$defs/assocQuery"
        },
        {
          "$ref": "#/$defs/effectQuery"
        },
        {
          "$ref": "#/$defs/identifyQuery"
        },
        {
          "$ref": "#/$defs/probabilityQuery"
        },
        {
          "$ref": "#/$defs/counterfactualQuery"
        }
      ]
    },
    "queryStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "query"
      ],
      "properties": {
        "kind": {
          "const": "query"
        },
        "id": {
          "$ref": "atom.schema.json#/$defs/identifier"
        },
        "query": {
          "$ref": "#/$defs/query"
        }
      }
    },
    "variableDeclaration": {
      "type": "object",
      "description": "Advisory per-predicate framing metadata (slice A0). Declaring a variable opts it into framing_notes: any unset field becomes a gap reported on queries that reference this predicate. Omitting a declaration silences framing for that predicate; nothing here gates reasoning.",
      "additionalProperties": false,
      "required": [
        "kind",
        "predicate"
      ],
      "properties": {
        "kind": {
          "const": "variable"
        },
        "predicate": {
          "$ref": "atom.schema.json#/$defs/identifier"
        },
        "domain": {
          "type": "array",
          "description": "Enumerated value domain, e.g. [true, false] or [\"low\",\"mid\",\"high\"]. Used only for framing; the runtime still reads actual domains from observed values.",
          "items": {
            "type": ["boolean", "integer", "number", "string"]
          }
        },
        "time_window": {
          "type": "string",
          "description": "Natural-language time window the variable refers to, e.g. \"12w\" or \"single exam\"."
        },
        "measurement": {
          "type": "string",
          "description": "How the variable is measured, e.g. \"waist circumference cm\" or \"self-reported daily minutes\"."
        },
        "threshold": {
          "type": "string",
          "description": "Cutoff that turns a continuous measurement into this predicate's value, e.g. \">=3cm\"."
        },
        "observability": {
          "type": "string",
          "description": "Whether the variable is observable / self-reported / latent in this setting."
        },
        "unit": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "description": "Slice #41. Effect polarity the predicate commits to: e.g. \"up\" (the predicate fires when the underlying quantity increases), \"down\", \"mixed\". Surfaces questions where '影响 X' is ambiguous between raise / lower / fluctuate."
        },
        "baseline": {
          "type": "string",
          "description": "Slice #41. The reference level a change is measured from, e.g. \"pre-intervention clinic BP\", \"school-reported mid-term score\". Surfaces questions like '提高数学成绩' where improvement relative to what baseline is not stated."
        },
        "state_vs_event": {
          "type": "string",
          "description": "Slice #41. Whether the predicate describes a habitual / persistent state or a discrete event: \"state\" vs \"event\". Surfaces ambiguity between e.g. '跟同事闹矛盾' as a one-off episode versus an ongoing relational state."
        }
      }
    },
    "statement": {
      "oneOf": [
        {
          "$ref": "#/$defs/causeStatement"
        },
        {
          "$ref": "#/$defs/bidirectedStatement"
        },
        {
          "$ref": "#/$defs/probabilityStatement"
        },
        {
          "$ref": "#/$defs/observationStatement"
        },
        {
          "$ref": "#/$defs/queryStatement"
        },
        {
          "$ref": "#/$defs/variableDeclaration"
        }
      ]
    }
  }
}
