      "annotations": {"source": "evidence", "evidence": "MacMahon et al 1990 Lancet 335:765 — meta-analysis of 9 prospective observational studies, 420000 individuals"}
    },
    {
      "kind": "cause",
      "from": {"predicate": "age", "args": [{"type": "const", "name": "person"}]},
