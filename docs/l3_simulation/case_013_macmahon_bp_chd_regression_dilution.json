      "annotations": {"source": "common_knowledge"}
    },
    {
      "kind": "cause",
      "from": {"predicate": "age", "args": [{"type": "const", "name": "person"}]},
      "to":   {"predicate": "chd_event", "args": [{"type": "const", "name": "person"}]},
      "annotations": {"source": "common_knowledge"}
    },
    {
      "kind": "cause",
      "from": {"predicate": "smoking", "args": [{"type": "const", "name": "person"}]},
      "to":   {"predicate": "chd_event", "args": [{"type": "const", "name": "person"}]},
      "annotations": {"source": "common_knowledge"}
    },
    {
      "kind": "query",
      "id": "q_bp_causes_chd",
      "query": {
        "kind": "effect",
        "target": {
          "atom": {"predicate": "chd_event", "args": [{"type": "const", "name": "person"}]},
