{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/causal-kernel/query_result.schema.json",
  "title": "Causal Kernel Query Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "query_kind"
  ],
  "properties": {
    "extensions": {
      "type": "object"
    },
    "status": {
      "enum": [
        "structurally_solved",
        "numerically_solved",
        "needs_investigation",
        "outside_language"
      ]
    },
    "query_id": {
      "type": "string"
    },
    "query_kind": {
      "enum": [
        "cause",
        "assoc",
        "effect",
        "identify",
        "probability"
      ]
    },
    "structural_result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "boolean",
            "string",
            "null"
          ]
        },
        "supporting_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "numeric_result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "interval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            }
          },
          "required": [
            "low",
            "high"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Composite confidence score for the whole result; not a statistical confidence interval."
    },
    "formula": {
      "oneOf": [
        {
          "$ref": "#/$defs/formulaExpression"
        },
        {
          "type": "null"
        }
      ]
    },
    "missing_information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missingItem"
      }
    },
    "investigation_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/investigationRequest"
      }
    },
    "framing_notes": {
      "type": "array",
      "description": "Slice A0 advisory channel: per-predicate gaps in variableDeclaration metadata for predicates referenced by the query. Advisory only — does not influence status.",
      "items": {
        "$ref": "#/$defs/framingNote"
      }
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "derivation": {
      "$ref": "derivation.schema.json",
      "description": "Machine-verifiable reasoning chain. Only present when the runtime attached one (identify / effect / probability / cause / assoc). Constrained to the exact derivation.schema.json shape so an external agent can round-trip through derivation_from_dict and re-run the verifier."
    }
  },
  "$defs": {
    "framingNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate",
        "missing"
      ],
      "properties": {
        "predicate": {
          "type": "string"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "domain",
              "time_window",
              "measurement",
              "threshold",
              "observability",
              "unit",
              "direction",
              "baseline",
              "state_vs_event"
            ]
          }
        }
      }
    },
    "varRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "const": "var_ref"
        },
        "name": {
          "type": "string",
          "description": "Must match the name of an enclosing sum's bind.name."
        }
      }
    },
    "valueExpr": {
      "description": "A concrete literal value or a reference to a bound value variable introduced by an enclosing sum.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/varRef"
        }
      ]
    },
    "valuedAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom"
      ],
      "properties": {
        "atom": {
          "$ref": "atom.schema.json#/$defs/atom"
        },
        "value": {
          "$ref": "#/$defs/valueExpr",
          "description": "Concrete literal, varRef bound by enclosing sum, or absent (the value is bound externally by the enclosing query's context — e.g., identify query's target or given atoms)."
        }
      }
    },
    "constantExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "constant"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "probabilityRefExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "given"
      ],
      "properties": {
        "kind": {
          "const": "probability_ref"
        },
        "target": {
          "$ref": "#/$defs/valuedAtom"
        },
        "given": {
          "type": "array",
          "description": "Valued atoms conditioned on. May be empty. Refers to any model-distribution conditional, not only literal Theta entries.",
          "items": {
            "$ref": "#/$defs/valuedAtom"
          }
        }
      }
    },
    "productExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "terms"
      ],
      "properties": {
        "kind": {
          "const": "product"
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formulaExpression"
          }
        }
      }
    },
    "bindDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Fresh value-variable name introduced by the enclosing sum. Referenced by varRef in the body."
        }
      }
    },
    "sumExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bind",
        "over",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "sum"
        },
        "bind": {
          "$ref": "#/$defs/bindDecl"
        },
        "over": {
          "$ref": "atom.schema.json#/$defs/atom",
          "description": "Atom whose value domain is iterated. Validator MUST enforce that this atom is ground (contains no var terms)."
        },
        "body": {
          "$ref": "#/$defs/formulaExpression"
        }
      }
    },
    "formulaExpression": {
      "oneOf": [
        {
          "$ref": "#/$defs/constantExpr"
        },
        {
          "$ref": "#/$defs/probabilityRefExpr"
        },
        {
          "$ref": "#/$defs/productExpr"
        },
        {
          "$ref": "#/$defs/sumExpr"
        }
      ]
    },
    "missingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "priority"
      ],
      "properties": {
        "kind": {
          "enum": [
            "parameter",
            "observation",
            "sample",
            "structure",
            "framing"
          ]
        },
        "name": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "parameterSkeleton": {
      "type": "object",
      "description": "Paste-ready stub for a missing probability CPT entry. Emitted by the investigation_pusher as investigationItem.skeleton when the MissingKind is 'parameter'. Round-trippable into a kernel_ast probabilityStatement once the user fills the numeric value.",
      "additionalProperties": false,
      "required": ["kind", "target", "given", "value"],
      "properties": {
        "kind": { "const": "probability" },
        "target": { "$ref": "atom.schema.json#/$defs/groundedAtom" },
        "given": {
          "type": "array",
          "items": { "$ref": "atom.schema.json#/$defs/groundedAtom" }
        },
        "value": {
          "type": ["number", "null"],
          "description": "Null in the freshly-emitted skeleton; the user fills it in before merging back via apply_patch_and_run. Once set, must fall in [0, 1] (enforced by merge)."
        },
        "annotations": {
          "type": "object",
          "description": "Free-form metadata carried through merge (e.g. {\"source\": \"TODO\"} on emission, {\"source\": \"user_report\"} after fill)."
        }
      }
    },
    "variablePatch": {
      "type": "object",
      "description": "Paste-ready stub for framing a declared variable. Emitted by slice F1 (DEFINE_VARIABLE investigation) as investigationItem.skeleton. The user fills nulls in the 'fields' map; 'existing' is read-only context.",
      "additionalProperties": false,
      "required": ["kind", "predicate", "fields"],
      "properties": {
        "kind": { "const": "variable_patch" },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "existing": {
          "type": "object",
          "description": "Read-only snapshot of framing fields already set on the VariableDeclaration. Merge never writes back into this map."
        },
        "fields": {
          "type": "object",
          "description": "Per-field fill surface. Each legal key maps to the kind that A0/F1 reports as a gap. Value null means the user has not filled it yet; any non-null value is interpreted by merge per field semantics.",
          "additionalProperties": {
            "type": ["string", "array", "null"]
          }
        }
      }
    },
    "investigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "description": "Structured identifier matching the originating MissingItem.name."
        },
        "reason": {
          "type": "string"
        },
        "skeleton": {
          "description": "Paste-ready statement stub. Exactly one of two shapes — a parameter skeleton (the user fills in 'value') or a variable_patch (the user fills the fields dict). No third shape is accepted; new skeleton kinds land as explicit additions here.",
          "oneOf": [
            { "$ref": "#/$defs/parameterSkeleton" },
            { "$ref": "#/$defs/variablePatch" }
          ]
        }
      }
    },
    "investigationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target",
        "priority"
      ],
      "properties": {
        "action": {
          "enum": [
            "collect_observation",
            "run_experiment",
            "increase_sample",
            "validate_parameter",
            "define_variable"
          ]
        },
        "target": {
          "type": "string",
          "description": "For a single-item request this is the MissingItem.name. For a grouped request, a short summary ('N items')."
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "note": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "description": "MissingKind.value for parameter/observation/sample/structure groups, or 'framing' for DEFINE_VARIABLE (slice F1) — items in the same request share a channel."
        },
        "items": {
          "type": "array",
          "description": "Per-item details within this grouped request. Always populated in v0.2 (length >= 1).",
          "items": {
            "$ref": "#/$defs/investigationItem"
          }
        }
      }
    }
  }
}
