{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/causal-kernel/atom.schema.json",
  "title": "Causal Kernel Atom v0.1",
  "description": "Shared atom / term definitions used by kernel_ast and query_result schemas.",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "variableName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_]*$"
    },
    "constTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "const": "const"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "varTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "const": "var"
        },
        "name": {
          "$ref": "#/$defs/variableName"
        }
      }
    },
    "term": {
      "oneOf": [
        {
          "$ref": "#/$defs/constTerm"
        },
        {
          "$ref": "#/$defs/varTerm"
        }
      ]
    },
    "relativeTimeIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "relative"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate",
        "args"
      ],
      "properties": {
        "predicate": {
          "$ref": "#/$defs/identifier"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "time_index": {
          "$ref": "#/$defs/relativeTimeIndex"
        }
      }
    },
    "literalValue": {
      "description": "Concrete value of an atom: literal only (no VarRef).",
      "oneOf": [
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"}
      ]
    },
    "groundedAtom": {
      "description": "Atom paired with a concrete literal value. Used in kernel_ast statements where the value must be known at program time (probabilityStatement, probabilityQuery, effectQuery target/given). For formula ASTs (query_result.schema.json) use the broader valuedAtom that additionally admits VarRef.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom",
        "value"
      ],
      "properties": {
        "atom": {
          "$ref": "#/$defs/atom"
        },
        "value": {
          "$ref": "#/$defs/literalValue"
        }
      }
    }
  }
}
