{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/causal-kernel/verification_context.schema.json",
  "title": "Verifier Context Payload v0.1",
  "description": "Serialized form of a VerificationContext for slice V5. Paired with derivation.schema.json, this lets external tools re-run verify_* end to end without any Python objects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "graph", "query", "theta"],
  "properties": {
    "version": { "const": "0.1" },
    "kind": { "const": "verification_context" },
    "graph": { "$ref": "#/$defs/graph" },
    "query": { "$ref": "#/$defs/query" },
    "theta": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/theta" }
      ]
    }
  },
  "$defs": {
    "atom_value": {
      "type": ["boolean", "number", "string"]
    },
    "term": {
      "$ref": "derivation.schema.json#/$defs/term",
      "description": "Shape recorded once, in derivation.schema.json."
    },
    "atom": {
      "$ref": "derivation.schema.json#/$defs/atom",
      "description": "The kinded node language is the derivation's own — a step is made of these — and the verifier's two artifacts speak it because one producer writes both."
    },
    "valued_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "atom", "value"],
      "properties": {
        "kind": { "const": "valued_atom" },
        "atom": { "$ref": "#/$defs/atom" },
        "value": { "$ref": "#/$defs/atom_value" }
      }
    },
    "graph": {
      "$ref": "derivation.schema.json#/$defs/graph",
      "description": "Shape recorded once, in derivation.schema.json."
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "atom", "value"],
      "properties": {
        "kind": { "const": "intervention" },
        "atom": { "$ref": "#/$defs/atom" },
        "value": { "$ref": "#/$defs/atom_value" }
      }
    },
    "cause_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from_atom", "to_atom"],
      "properties": {
        "kind": { "const": "cause_query" },
        "from_atom": { "$ref": "#/$defs/atom" },
        "to_atom": { "$ref": "#/$defs/atom" }
      }
    },
    "assoc_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "left", "right"],
      "properties": {
        "kind": { "const": "assoc_query" },
        "left": { "$ref": "#/$defs/atom" },
        "right": { "$ref": "#/$defs/atom" },
        "given": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        }
      }
    },
    "identify_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "intervention"],
      "properties": {
        "kind": { "const": "identify_query" },
        "target": { "$ref": "#/$defs/atom" },
        "intervention": { "$ref": "#/$defs/intervention" },
        "given": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        }
      }
    },
    "effect_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "intervention"],
      "properties": {
        "kind": { "const": "effect_query" },
        "target": { "$ref": "#/$defs/valued_atom" },
        "intervention": { "$ref": "#/$defs/intervention" },
        "given": {
          "type": "array",
          "items": { "$ref": "#/$defs/valued_atom" }
        }
      }
    },
    "probability_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "const": "probability_query" },
        "target": { "$ref": "#/$defs/valued_atom" },
        "given": {
          "type": "array",
          "items": { "$ref": "#/$defs/valued_atom" }
        }
      }
    },
    "counterfactual_assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monotonicity"],
      "properties": {
        "monotonicity": {
          "type": "string",
          "enum": ["non_decreasing", "non_increasing"]
        }
      }
    },
    "counterfactual_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "observed",
        "counterfactual_intervention",
        "counterfactual_target"
      ],
      "properties": {
        "kind": { "const": "counterfactual_query" },
        "observed": { "$ref": "#/$defs/valued_atom" },
        "counterfactual_intervention": { "$ref": "#/$defs/intervention" },
        "counterfactual_target": { "$ref": "#/$defs/valued_atom" },
        "assumptions": { "$ref": "#/$defs/counterfactual_assumptions" },
        "factual_target_known": {
          "type": ["boolean", "number", "string"]
        },
        "experimental_risk_treated": { "type": "number", "minimum": 0, "maximum": 1 },
        "experimental_risk_control": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "query": {
      "oneOf": [
        { "$ref": "#/$defs/cause_query" },
        { "$ref": "#/$defs/assoc_query" },
        { "$ref": "#/$defs/identify_query" },
        { "$ref": "#/$defs/effect_query" },
        { "$ref": "#/$defs/probability_query" },
        { "$ref": "#/$defs/counterfactual_query" }
      ]
    },
    "probability_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_atom", "target_value", "given"],
      "properties": {
        "kind": { "const": "probability_key" },
        "target_atom": { "$ref": "#/$defs/atom" },
        "target_value": { "$ref": "#/$defs/atom_value" },
        "given": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atom", "value"],
            "properties": {
              "atom": { "$ref": "#/$defs/atom" },
              "value": { "$ref": "#/$defs/atom_value" }
            }
          }
        },
        "population": {
          "type": "string",
          "description": "Fix 3+4: optional population label routing this key to a specific theta partition. Absent = default / source population."
        }
      }
    },
    "theta_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/probability_key" },
        "value": { "type": "number" }
      }
    },
    "theta_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom", "values"],
      "properties": {
        "atom": { "$ref": "#/$defs/atom" },
        "values": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom_value" }
        }
      }
    },
    "theta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entries", "domains"],
      "properties": {
        "kind": { "const": "theta" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/theta_entry" }
        },
        "domains": {
          "type": "array",
          "items": { "$ref": "#/$defs/theta_domain" }
        }
      }
    }
  }
}
