{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/causal-kernel/derivation.schema.json",
  "title": "Verifier Derivation Payload v0.1",
  "description": "Serialized form of a QueryResult.derivation for slice V2. The JSON constrains both the outer structure and the tagged-value shapes; per-rule input/output compatibility is still enforced by the verifier itself when it re-hydrates and walks the derivation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "steps"],
  "properties": {
    "version": { "const": "0.1" },
    "kind": { "const": "derivation" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "primitive": {
      "type": ["boolean", "number", "string", "null"]
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "type": "string", "enum": ["const", "var"] },
        "name": { "type": "string" }
      }
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predicate", "args"],
      "properties": {
        "kind": { "const": "atom" },
        "predicate": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/term" }
        },
        "time_index": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "relative" },
            "value": { "type": "integer" }
          }
        }
      }
    },
    "valued_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "atom", "value"],
      "properties": {
        "kind": { "const": "valued_atom" },
        "atom": { "$ref": "#/$defs/atom" },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "var_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "var_ref" },
        "name": { "type": "string" }
      }
    },
    "step_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "step_id"],
      "properties": {
        "kind": { "const": "step_ref" },
        "step_id": { "type": "string" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodes", "edges"],
      "properties": {
        "kind": { "const": "graph" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer" }
          }
        }
      }
    },
    "structural_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "structural_result" },
        "value": { "type": ["boolean", "string", "null"] },
        "supporting_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "numeric_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "numeric_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "numeric_result" },
        "value": { "type": ["number", "null"] },
        "interval": { "$ref": "#/$defs/numeric_interval" },
        "unit": { "type": "string" }
      }
    },
    "constant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "constant" },
        "value": { "type": "number" }
      }
    },
    "probability_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "given"],
      "properties": {
        "kind": { "const": "probability_ref" },
        "target": { "$ref": "#/$defs/valued_atom" },
        "given": {
          "type": "array",
          "items": { "$ref": "#/$defs/valued_atom" }
        },
        "population": {
          "type": "string",
          "description": "Fix 3+4 (charter FIX_3_4_CHARTER_llm_mediated_transport.md): optional population label routing this lookup to a specific theta partition. Absent = default / source population. Used by transport_formula to differentiate P(...|do, source) from P*(z, target) in the same tree."
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "terms"],
      "properties": {
        "kind": { "const": "product" },
        "terms": {
          "type": "array",
          "items": { "$ref": "#/$defs/formula" }
        }
      }
    },
    "sum_bind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" }
      }
    },
    "sum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bind", "over", "body"],
      "properties": {
        "kind": { "const": "sum" },
        "bind": { "$ref": "#/$defs/sum_bind" },
        "over": { "$ref": "#/$defs/atom" },
        "body": { "$ref": "#/$defs/formula" }
      }
    },
    "atom_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "atom_set" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        }
      }
    },
    "atom_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "atom_tuple" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        }
      }
    },
    "valued_atom_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "valued_atom_tuple" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/valued_atom" }
        }
      }
    },
    "atom_paths": {
      "type": "object",
      "description": "V4: a tuple of witness paths; each path is an ordered array of atoms. Used by cause_via_directed_path and d_connected_via_open_path to carry the concrete paths whose edges the verifier rechecks.",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "atom_paths" },
        "items": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/atom" }
          }
        }
      }
    },
    "value_tuple": {
      "type": "object",
      "description": "Generic tagged-tuple: an ordered sequence whose elements each recurse to the value shape. The homogeneous tuple tags above (atom_tuple / valued_atom_tuple / atom_paths) stay the encoding for their shapes; this one carries the rest — e.g. the per-stratum table an instrumental-variable Wald emits, which is a tuple of dicts. Order is meaningful and is preserved.",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "value_tuple" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        }
      }
    },
    "dict": {
      "type": "object",
      "description": "Generic tagged-dict carrying a structured multi-quantity payload. Keys are strings; values recurse to the value shape (primitive or tagged). Used by rules whose output is genuinely multi-component — e.g. mediation_numeric_evaluate which returns TE / NDE-at-control / NIE-at-treated plus an optional CDE-per-mediator-value sub-dict. Verifier re-runs and compares the whole payload.",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "dict" },
        "items": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    },
    "fraction": {
      "type": "object",
      "description": "A ratio of two formulas. Introduced by conditional identification (IDC): P(Y|do(X),Z) = ID(Y∪Z_rem, X') / ID(Z_rem, X'). The only formula node that introduces division.",
      "additionalProperties": false,
      "required": ["kind", "numerator", "denominator"],
      "properties": {
        "kind": { "const": "fraction" },
        "numerator": { "$ref": "#/$defs/formula" },
        "denominator": { "$ref": "#/$defs/formula" }
      }
    },
    "formula": {
      "oneOf": [
        { "$ref": "#/$defs/constant" },
        { "$ref": "#/$defs/probability_ref" },
        { "$ref": "#/$defs/product" },
        { "$ref": "#/$defs/sum" },
        { "$ref": "#/$defs/fraction" }
      ]
    },
    "tagged": {
      "oneOf": [
        { "$ref": "#/$defs/atom" },
        { "$ref": "#/$defs/valued_atom" },
        { "$ref": "#/$defs/var_ref" },
        { "$ref": "#/$defs/step_ref" },
        { "$ref": "#/$defs/graph" },
        { "$ref": "#/$defs/structural_result" },
        { "$ref": "#/$defs/numeric_result" },
        { "$ref": "#/$defs/constant" },
        { "$ref": "#/$defs/probability_ref" },
        { "$ref": "#/$defs/product" },
        { "$ref": "#/$defs/sum" },
        { "$ref": "#/$defs/fraction" },
        { "$ref": "#/$defs/atom_set" },
        { "$ref": "#/$defs/atom_tuple" },
        { "$ref": "#/$defs/valued_atom_tuple" },
        { "$ref": "#/$defs/atom_paths" },
        { "$ref": "#/$defs/value_tuple" },
        { "$ref": "#/$defs/dict" }
      ]
    },
    "value": {
      "description": "A derivation value: primitive, or a tagged object with a fully specified shape.",
      "oneOf": [
        { "$ref": "#/$defs/primitive" },
        { "$ref": "#/$defs/tagged" }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "inputs", "output"],
      "properties": {
        "rule": { "type": "string" },
        "step_id": { "type": "string" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        },
        "output": { "$ref": "#/$defs/value" },
        "success": {
          "type": "boolean",
          "description": "False marks a derivation step that ran and produced a structural failure. Default true, and the kernel never sets it: its derivations carry only steps that succeeded, and it says 'not identifiable' either with a successful tian_hedge_witness step (whose c-component the verifier replays) or with an investigation item, never with a step that failed. The field is here for a derivation that arrives from outside and claims a failure — the verifier reads it so that the claim can be checked (T10-3 requires the gap citing such a step to exist, and the replay rule re-runs the search the claim asserts came up empty)."
        }
      }
    }
  }
}
